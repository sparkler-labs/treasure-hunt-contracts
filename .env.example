# 链上环境变量示例（复制为 .env 后填写；仅本地链开发无需任何配置）

# ===== 部署账户（各链通用同一个 EOA） =====
PRIVATE_KEY=

# ===== 测试环境 =====
SEPOLIA_RPC_URL=

# ===== 正式环境（留空则用各链默认公共 RPC） =====
ROBINHOOD_RPC_URL=
BSC_RPC_URL=
ARBITRUM_RPC_URL=
OPTIMISM_RPC_URL=

# ===== 合约验证（可选） =====
ETHERSCAN_API_KEY=
BSCSCAN_API_KEY=
ARBISCAN_API_KEY=
OPSCAN_API_KEY=
